BOT_TOKEN=your_telegram_bot_token
OWNER_ID=123456789
BINGO_BOT_USERNAME=YourBingoBotUsername

# ── Database ──────────────────────────────────────────────────────────────────
# Option A (RECOMMENDED): MongoDB — persistent across restarts, works on any host.
# Use the same MongoDB cluster as your Bingo bot.
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=tournamentBot

# Option B: SQLite — only reliable on local machines or Render with a persistent disk.
# On Heroku, Railway, or any ephemeral filesystem, data is lost on restart → "Tournament not found" errors.
DATABASE_PATH=./database.sqlite

# ── Webhook (optional) ────────────────────────────────────────────────────────
# Leave unset to use polling mode (fine for local dev).
# Set to your public HTTPS domain to use webhook mode on Render/cloud.
# WEBHOOK_DOMAIN=https://your-render-app.onrender.com
